# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Service-specific settings are documented in each service's
# `.env.example` file.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
# LOG_LEVEL=

# # ---- Frontend -------------
# FRONTEND_ORIGIN=

# # ---- Auth / JWT -----------
# JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL=
# JWT_REFRESH_TOKEN_TTL=
# JWT_EXPIRES_IN=

# # ---- Refresh Token Expiration ----
# REFRESH_TOKEN_EXPIRES_DAYS=

# ---- Shared by service Compose files (see each service .env.example) ----
# DB_USER=
# DB_PASSWORD=
# DB_DATABASE=
# JWT_SECRET=

# Credit service (prefixed so they do not clash with other databases)
CREDIT_DB_DATABASE=credit_service
CREDIT_DB_EXTERNAL_PORT=5436
CREDIT_PORT=3004

# Order service
ORDER_PORT=3003
ORDER_DB_DATABASE=order_service
ORDER_DB_EXTERNAL_PORT=5435

# RabbitMQ (order-service starts it; credit-service consumes it)
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_EXCHANGE=orders

# Host-side process URLs. Root compose.yaml sets the in-network gateway URLs.
USER_SERVICE_URL=http://localhost:3002
SUPPLIER_SERVICE_URL=http://localhost:3001
CREDIT_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3003

