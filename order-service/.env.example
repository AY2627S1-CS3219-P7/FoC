PORT=3003
CORS_ORIGIN=http://localhost:5173

DB_USER=postgres
DB_PASSWORD=change-me
DB_DATABASE=order_service
DB_PORT=5435

JWT_SECRET=change-this-to-a-random-secret

# --- RabbitMQ ---
# Credentials for the broker started by this compose file.
# If you change the password and it contains special characters, it must be
# URL-encoded in RABBITMQ_URL, which compose builds from these values.
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Credit service ---
CREDIT_SERVICE_URL=http://host.docker.internal:3004

# Optional shared secret sent as X-Internal-Api-Key on calls to the credit
# service. Leave empty until the credit service checks it.
INTERNAL_API_KEY=
