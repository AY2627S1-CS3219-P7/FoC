{
   "containerDefinitions": [ 
      { 
         "name": "user-service",
         "essential": true,
         "image": "551162198630.dkr.ecr.ap-southeast-1.amazonaws.com/cs3219ay2627s1/p7:user-service",
         "logConfiguration": { 
            "logDriver": "awslogs",
            "options": { 
               "awslogs-group" : "/ecs/user-service",
               "awslogs-region": "ap-southeast-1",
               "awslogs-stream-prefix": "ecs"
            }
         },
         "portMappings": [ 
            { 
               "containerPort": 3002,
               "protocol": "tcp"
            }
         ],
         "environment": [
            {
               "name": "CORS_ORIGIN",
               "value": "https://d3414od56848h5.cloudfront.net"
            },
            {
               "name": "PORT",
               "value": "3002"
            },
            {
               "name": "NODE_ENV",
               "value": "production"
            },
            {
               "name": "CREDIT_SERVICE_URL",
               "value": "http://credit-service.cs3219.local:3004"
            },
            {
               "name": "DB_HOST",
               "value": "cs3219-p7-db.cj0ioumo0c66.ap-southeast-1.rds.amazonaws.com"
            },
            {
               "name": "DB_PORT",
               "value": "5432"
            },
            {
               "name": "DB_SSL",
               "value": "true"
            },
            {
               "name": "DB_DATABASE",
               "value": "user_service"
            },
            {
               "name": "JWT_EXPIRES_IN",
               "value": "15m"
            },
            {
               "name": "INITIAL_ADMIN_EMAIL",
               "value": "admin@u.nus.edu"
            },
            {
               "name": "INITIAL_ADMIN_USERNAME",
               "value": "sys_admin"
            },
            {
               "name": "INITIAL_ADMIN_FIRST_NAME",
               "value": "System"
            },
            {
               "name": "INITIAL_ADMIN_LAST_NAME",
               "value": "Administrator"
            },
            {
               "name": "REFRESH_TOKEN_EXPIRES_DAYS",
               "value": "30"
            }
            ],
         "secrets": [
            {
               "name": "DB_USER",
               "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:551162198630:secret:rds!db-f0d18bdc-a5c2-4eb9-b798-5e487ccbda7a-aF5Dvf:username::"
            },
            {
               "name": "DB_PASSWORD",
               "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:551162198630:secret:rds!db-f0d18bdc-a5c2-4eb9-b798-5e487ccbda7a-aF5Dvf:password::"
            },
            {
               "name": "JWT_SECRET",
               "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:551162198630:secret:jwt-secret-dJMHAB"
            },
            {
               "name": "INITIAL_ADMIN_PASSWORD",
               "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:551162198630:secret:initial-admin-password-1IMJ7y"
            }
         ]
      }
   ],
   "cpu": "256",
   "executionRoleArn": "arn:aws:iam::551162198630:role/ecsTaskExecutionRole",
   "family": "user-service-task",
   "memory": "512",
   "networkMode": "awsvpc",
   "runtimePlatform": {
        "operatingSystemFamily": "LINUX"
    },
   "requiresCompatibilities": [ 
       "FARGATE" 
    ]
}