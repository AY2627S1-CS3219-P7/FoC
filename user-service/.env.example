PORT=3002
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
CREDIT_SERVICE_URL=http://credit-service-api:3004

# Database connection
DB_HOST=localhost
DB_PORT=5434
DB_DATABASE=user_service_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Docker host port mapping
DB_EXTERNAL_PORT=5434

# JWT Security
JWT_SECRET=super-secret-development-key-change-in-prod
JWT_EXPIRES_IN=15m

# Day 0 Admin Bootstrap
INITIAL_ADMIN_EMAIL=admin@u.nus.edu
INITIAL_ADMIN_PASSWORD=CampusAdminSecret2026A
INITIAL_ADMIN_USERNAME=sys_admin
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

REFRESH_TOKEN_EXPIRES_DAYS=30

# RabbitMQ: USER_REGISTERED events for the notification service (optional;
# unset RABBITMQ_URL to disable). Compose builds the URL from these.
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=change-me
